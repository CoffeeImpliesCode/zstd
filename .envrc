# direnv entry point for the Zstandard SDK.
#
# devenv 2.x exposes its generated direnv script through `devenv direnvrc`;
# there is no separate `devenv.env` file to source and no flag to pass.
#
# Without devenv on PATH this prints how to enter the shell instead of failing
# silently in a directory that looks configured and is not.
#
# Scratch location, DEVENV_HOME, XDG_RUNTIME_DIR and the two Zig caches are the
# caller's to supply; nothing here hard-codes a path or clears an inherited
# variable.
#
# SPDX-License-Identifier: BSD-3-Clause
# See FORK-LICENSE.md for what that identifier covers.

if command -v devenv >/dev/null 2>&1; then
    eval "$(devenv direnvrc)"
else
    echo "devenv is not on PATH; run 'devenv shell' in this directory instead." >&2
fi